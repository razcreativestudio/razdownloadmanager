<!DOCTYPE html>
<html lang="id" data-theme="dark">

<head>
    <!-- ==============================================
         RAZ Download Manager - Official Website
         Deskripsi: Landing page resmi RAZ Download Manager (IDM Alternative)
         Terakhir diupdate: 2026-11-11
         Versi: 1.0.0 (RAZ DM Enterprise Release)
         Standar: RAZ Enterprise UI/UX Standard
    ============================================== -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="RAZ Download Manager — Download manager open-source berkecepatan tinggi alternatif IDM. Engine multi-thread Rust 5.4× lebih cepat, resume anti-rusak, terintegrasi BitTorrent, video sniffer, dan AI MCP. 100% gratis tanpa iklan.">
    <meta name="keywords"
        content="RAZ Download Manager, IDM alternative, alternatif IDM gratis, download manager terbaik, rust download manager, torrent client, video sniffer, RAZ Creative Studio, dm.it-raz.com">
    <meta name="author" content="RAZ Creative Studio">
    <link rel="canonical" href="https://dm.it-raz.com/">

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://dm.it-raz.com/">
    <meta property="og:site_name" content="RAZ Download Manager">
    <meta property="og:title" content="RAZ Download Manager — Download Super Kencang & IDM Alternative Bebas Lisensi">
    <meta property="og:description"
        content="Download manager modern open-source pengganti IDM berbasis Rust. Akselerasi 64 koneksi paralel, resume aman, torrent & video sniffer terintegrasi. 100% gratis selamanya.">
    <meta property="og:image" content="https://dm.it-raz.com/assets/logo-640.png">
    <meta property="og:locale" content="id_ID">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://dm.it-raz.com/">
    <meta name="twitter:title" content="RAZ Download Manager — IDM Alternative Berkecepatan Tinggi">
    <meta name="twitter:description"
        content="5.4× lebih cepat dari IDM di pengujian benchmark resmi. Free & open-source, bebas pop-up lisensi palsu.">
    <meta name="twitter:image" content="https://dm.it-raz.com/assets/logo-640.png">

    <!-- Favicon & Touch Icons -->
    <link rel="icon" href="favicon.ico" sizes="16x16 32x32 48x48 64x64">
    <link rel="icon" href="assets/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="assets/apple-touch-icon.png">

    <title>RAZ Download Manager — IDM Alternative Berkecepatan Tinggi & Open Source</title>

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "RAZ Download Manager",
      "operatingSystem": "Windows 10, Windows 11, macOS, Linux",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "url": "https://dm.it-raz.com/",
      "image": "https://dm.it-raz.com/assets/logo-640.png",
      "softwareVersion": "1.0.0",
      "description": "High-performance, free and open-source download manager and IDM alternative written in native Rust."
    }
    </script>

    <!-- Resource Hints & Google Fonts: Inter + Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- RAZ Stylesheets -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/RAZHero.css">
    <link rel="stylesheet" href="css/RAZMainAnimations.css">
    <link rel="stylesheet" href="css/RAZMainTheme.css">
    <link rel="stylesheet" href="css/RAZModal.css">
    <link rel="stylesheet" href="css/RAZDM.css">
</head>

<body>

    <!-- ======================== SPLASH SCREEN ======================== -->
    <div class="raz-splash-screen" id="raz-splash">
        <img src="img/raz-logo11.svg" alt="RAZ Download Manager Logo" class="raz-splash-logo" width="110" height="110"
            fetchpriority="high">
        <div class="raz-splash-spinner"></div>
        <div class="raz-splash-text" data-lang-key="splash-loading">Memuat RAZ Download Manager...</div>
    </div>

    <!-- ======================== FLOATING PARTICLES ======================== -->
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>

    <!-- ======================== CONTROL BUTTONS (LANG & THEME) ======================== -->
    <div class="raz-controls" id="raz-controls">
        <button class="raz-control-btn raz-lang-btn" id="raz-lang-toggle" aria-label="Switch Language">EN</button>
        <button class="raz-control-btn raz-theme-btn" id="raz-theme-toggle" aria-label="Toggle Theme"><i
                class="fas fa-moon"></i></button>
    </div>

    <!-- ======================== HEADER / NAVIGASI ======================== -->
    <header class="header" id="main-header">
        <div class="container">
            <h1 class="logo">
                <a href="index.html" style="display:flex;align-items:center;gap:12px;">
                    <img src="img/raz-logo.svg" alt="RAZ Download Manager" class="logo-image" style="height:44px;width:auto;">
                </a>
            </h1>
            <nav class="nav-menu">
                <button class="nav-toggle" id="nav-toggle-btn" aria-label="Toggle navigation">
                    <span class="gold-line"></span>
                    <span class="gold-line"></span>
                    <span class="gold-line"></span>
                </button>
                <ul class="nav-list" id="nav-list">
                    <li><a href="#hero" class="nav-link" data-lang-key="nav-home">Beranda</a></li>
                    <li><a href="#features" class="nav-link" data-lang-key="nav-features">Fitur</a></li>
                    <li><a href="#benchmark" class="nav-link" data-lang-key="nav-benchmark">Benchmark vs IDM</a></li>
                    <li><a href="#compare" class="nav-link" data-lang-key="nav-compare">Perbandingan</a></li>
                    <li><a href="#faq" class="nav-link" data-lang-key="nav-faq">FAQ</a></li>
                    <li><a href="https://github.com/razcreativestudio/razdownloadmanager" target="_blank"
                            class="nav-link" title="GitHub Repository"><i class="fab fa-github"></i> GitHub</a></li>
                    <li><a href="#download" class="nav-link cta-button" data-lang-key="nav-btn-download">Unduh Gratis</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- ======================== HERO SECTION ======================== -->
    <section id="hero" class="hero">
        <canvas id="hero-canvas"></canvas>
        <div class="hero-overlay"></div>

        <!-- Floating tech keywords -->
        <div class="hero-keywords">
            <span class="keyword">Rust Native Engine</span>
            <span class="keyword">64 Parallel Streams</span>
            <span class="keyword">BitTorrent Client</span>
            <span class="keyword">IDM Alternative</span>
            <span class="keyword">Video Sniffer 4K</span>
            <span class="keyword">Zero Bloatware</span>
            <span class="keyword">Open Source GPL-3</span>
            <span class="keyword">AI MCP Assistant</span>
        </div>

        <div class="hero-content">
            <div class="hero-badge">
                <span class="badge-dot"></span>
                <span data-lang-key="hero-badge">The Next-Gen High-Speed Download Manager</span>
            </div>
            <h2 class="hero-title">
                <span data-lang-key="hero-title-1">Download Ngebut Tanpa Batas,</span><br>
                <span class="gold-text gold-shimmer" data-lang-key="hero-title-2">Bebas Lisensi & Nol Iklan</span>
            </h2>
            <p class="hero-subtitle" data-lang-key="hero-subtitle">
                Download manager modern berbasis Rust dengan arsitektur multi-thread hingga 64 jalur simultan. Gak ada
                lagi drama pop-up lisensi bajakan atau trial expired. Terintegrasi BitTorrent, video sniffer, dan AI
                Assistant.
            </p>

            <div class="hero-cta-group">
                <a href="#download" class="cta-primary">
                    <i class="fas fa-download"></i>
                    <span data-lang-key="hero-btn-download">Unduh Installer (v1.0.0)</span>
                </a>
                <a href="#benchmark" class="cta-secondary">
                    <i class="fas fa-bolt"></i>
                    <span data-lang-key="hero-btn-benchmark">Lihat Benchmark vs IDM</span>
                </a>
            </div>

            <div class="hero-meta-badge">
                <i class="fab fa-windows"></i>
                <span data-lang-key="hero-meta">Windows 10/11 (64-bit) • 100% Open Source • Terverifikasi Bebas
                    Virus/Malware</span>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="scroll-indicator">
            <span data-lang-key="hero-scroll">Scroll</span>
            <div class="scroll-arrow"></div>
        </div>
    </section>

    <!-- ======================== SPEED HIGHLIGHT METRICS ======================== -->
    <section class="speed-metric-bar">
        <div class="container">
            <div class="metric-grid">
                <div class="metric-card">
                    <div class="metric-value" data-lang-key="metric-speed-val">5.4×</div>
                    <div class="metric-title" data-lang-key="metric-speed-title">Lebih Cepat dari IDM</div>
                    <div class="metric-desc" data-lang-key="metric-speed-desc">Berdasarkan pengujian resmi file 1 GiB dengan koneksi multi-part paralel.</div>
                </div>
                <div class="metric-card">
                    <div class="metric-value" data-lang-key="metric-threads-val">64</div>
                    <div class="metric-title" data-lang-key="metric-threads-title">Koneksi Simultan</div>
                    <div class="metric-desc" data-lang-key="metric-threads-desc">Membagi file jadi puluhan bagian dan menariknya bersamaan.</div>
                </div>
                <div class="metric-card">
                    <div class="metric-value" data-lang-key="metric-bloat-val">0 MB</div>
                    <div class="metric-title" data-lang-key="metric-bloat-title">Zero Bloatware</div>
                    <div class="metric-desc" data-lang-key="metric-bloat-desc">Murni dibuat dengan Rust native, tanpa Java, tanpa Electron.</div>
                </div>
                <div class="metric-card">
                    <div class="metric-value" data-lang-key="metric-sat-val">100%</div>
                    <div class="metric-title" data-lang-key="metric-sat-title">Saturasi Bandwidth</div>
                    <div class="metric-desc" data-lang-key="metric-sat-desc">Maksimalkan throughput ISP lo sampai ke batas kapasitas tertinggi.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================== INTERACTIVE SPEED BENCHMARK ======================== -->
    <hr class="section-separator">
    <section id="benchmark" class="section">
        <div class="container">
            <span class="section-label" data-lang-key="bench-label">Pembuktian Kecepatan Nyata</span>
            <h3 class="section-title">
                <span data-lang-key="bench-title-1">Bukan Sekadar Klaim,</span> <span class="gold"
                    data-lang-key="bench-title-2">Tapi Teruji Sampai Milidetik</span>
            </h3>
            <p class="section-subtitle" data-lang-key="bench-desc">
                Hasil benchmark kami di PC yang sama, server lokal yang sama, dan diuji secara bergantian.
            </p>

            <div class="benchmark-container" id="benchmark-race">
                <div class="benchmark-tabs">
                    <button class="bench-tab-btn active" data-lang-key="bench-tab-1gib">File 1 GiB (Koneksi Cepat)</button>
                    <button class="bench-tab-btn" data-lang-key="bench-tab-small">File Kecil (256 KiB)</button>
                    <button class="bench-tab-btn" data-lang-key="bench-tab-conns">Server Batas 2 Koneksi</button>
                </div>

                <div class="race-track-wrapper">
                    <!-- Lane RAZ Download Manager -->
                    <div class="race-lane razdm">
                        <div class="lane-header">
                            <div class="lane-identity">
                                <img src="img/raz-logo11.svg" alt="RAZ DM" style="width:28px;height:28px;">
                                <span class="lane-name">RAZ Download Manager</span>
                            </div>
                            <span class="lane-stat" id="race-time-raz">0.00 s</span>
                        </div>
                        <div class="lane-progress-bg">
                            <div class="lane-progress-bar" id="race-bar-raz"></div>
                        </div>
                        <div class="race-status-text">
                            <span>Status: Engine Rust 64-Thread Dynamic Re-splitting</span>
                            <span>Status: Aktif</span>
                        </div>
                    </div>

                    <!-- Lane IDM -->
                    <div class="race-lane idm">
                        <div class="lane-header">
                            <div class="lane-identity">
                                <span class="lane-badge-idm">IDM</span>
                                <span class="lane-name">Internet Download Manager 6.42</span>
                            </div>
                            <span class="lane-stat" id="race-time-idm">0.00 s</span>
                        </div>
                        <div class="lane-progress-bg">
                            <div class="lane-progress-bar" id="race-bar-idm"></div>
                        </div>
                        <div class="race-status-text">
                            <span>Status: Legacy Engine C++</span>
                            <span>Status: Standby</span>
                        </div>
                    </div>
                </div>

                <div class="race-summary-box">
                    <div class="race-big-ratio">
                        <span id="race-ratio-val">5.4×</span>
                        <small data-lang-key="bench-ratio-label">Lebih Kencang</small>
                    </div>
                    <div style="flex-grow:1;max-width:550px;text-align:left;font-size:0.92rem;" id="race-scenario-note">
                        RAZ DM selesai hanya dalam 1.01 detik menggunakan 64 koneksi simultan saturasi penuh, sedangkan
                        IDM membutuhkan 5.46 detik.
                    </div>
                    <button class="race-replay-btn" id="race-replay-btn">
                        <i class="fas fa-redo"></i>
                        <span data-lang-key="bench-replay">Putar Ulang Race</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================== INTERACTIVE APP TOUR / SHOWCASE ======================== -->
    <hr class="section-separator">
    <section class="section" id="tour">
        <div class="container">
            <span class="section-label" data-lang-key="tour-label">Tampilan Antarmuka</span>
            <h3 class="section-title">
                <span data-lang-key="tour-title-1">Desain Klasik yang Lo Kenal,</span> <span class="gold"
                    data-lang-key="tour-title-2">Engine Modern yang Jauh Lebih Kencang</span>
            </h3>
            <p class="section-subtitle" data-lang-key="tour-desc">
                Layout praktis dan familiar seperti download manager yang lo pake selama bertahun-tahun, tapi dengan
                teknologi modern dan fitur yang belum pernah ada sebelumnya.
            </p>

            <div class="app-tour-grid">
                <div class="tour-tab-list">
                    <div class="tour-tab-item active" data-img="assets/screens/progress-dark.webp">
                        <h4 data-lang-key="tour-tab-progress-title">Setiap Koneksi Terpantau Live</h4>
                        <p data-lang-key="tour-tab-progress-desc">Pantau kecepatan dan bagian file yang terisi secara real-time. Resume aman dari crash tanpa takut file rusak.</p>
                    </div>
                    <div class="tour-tab-item" data-img="assets/screens/torrent-dark.webp">
                        <h4 data-lang-key="tour-tab-torrents-title">BitTorrent Terintegrasi</h4>
                        <p data-lang-key="tour-tab-torrents-desc">Buka magnet link dan file .torrent langsung di daftar download tanpa butuh software torrent terpisah.</p>
                    </div>
                    <div class="tour-tab-item" data-img="assets/screens/video-dark.webp">
                        <h4 data-lang-key="tour-tab-video-title">Sniffer Video Web</h4>
                        <p data-lang-key="tour-tab-video-desc">Download video sampai kualitas 4K dari YouTube, Vimeo, dan ribuan situs streaming lainnya.</p>
                    </div>
                    <div class="tour-tab-item" data-img="assets/screens/scheduler-dark.webp">
                        <h4 data-lang-key="tour-tab-scheduler-title">Jadwal Antrean Otomatis</h4>
                        <p data-lang-key="tour-tab-scheduler-desc">Atur antrean download mulai jam 2 pagi, berhenti jam 6 pagi, dan otomatis matikan komputer setelah selesai.</p>
                    </div>
                    <div class="tour-tab-item" data-img="assets/screens/options-dark.webp">
                        <h4 data-lang-key="tour-tab-options-title">Pengaturan Lengkap</h4>
                        <p data-lang-key="tour-tab-options-desc">Atur koneksi per unduhan, proxy, suara, folder tujuan, hingga integrasi browser semau lo.</p>
                    </div>
                    <div class="tour-tab-item" data-img="assets/screens/main-dark.webp">
                        <h4>Layar Utama Modern</h4>
                        <p>Daftar unduhan bersih, kategorisasi otomatis (Dokumen, Video, Program, Musik), dan pencarian instan.</p>
                    </div>
                </div>

                <div class="tour-viewport">
                    <img id="tour-preview-img" src="assets/screens/progress-dark.webp" alt="Tampilan Antarmuka RAZ Download Manager"
                        loading="lazy">
                </div>
            </div>
        </div>
    </section>

    <!-- ======================== CORE FEATURES GRID ======================== -->
    <hr class="section-separator">
    <section id="features" class="section">
        <div class="container">
            <span class="section-label" data-lang-key="feat-label">Fitur Unggulan</span>
            <h3 class="section-title">
                <span data-lang-key="feat-title-1">Semua Kebutuhan Download Lo,</span> <span class="gold"
                    data-lang-key="feat-title-2">Sudah Ada di Dalamnya</span>
            </h3>
            <p class="section-subtitle" data-lang-key="feat-desc">
                Didesain untuk efisiensi maksimal, performa tinggi, dan kenyamanan pengguna tanpa kompromi.
            </p>

            <div class="download-grid">
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-bolt"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-1-title">Akselerasi Multi-Thread Turbo</h4>
                    <p class="dl-meta" data-lang-key="feat-1-desc">Membagi file menjadi hingga 64 segmen simultan dan otomatis memecah ulang segmen yang lambat.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-magnet"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-2-title">Torrent & Magnet Client</h4>
                    <p class="dl-meta" data-lang-key="feat-2-desc">Download file torrent langsung dengan kontrol file selektif dan visualisasi pieces yang detail.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-video"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-3-title">Video & Media Sniffer Otomatis</h4>
                    <p class="dl-meta" data-lang-key="feat-3-desc">Ekstensi browser mendeteksi video, audio, dan galeri secara otomatis untuk diunduh 1-klik.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-crown"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-4-title">Dukungan Akun Debrid</h4>
                    <p class="dl-meta" data-lang-key="feat-4-desc">Integrasi langsung dengan Real-Debrid, AllDebrid, dan Debrid-Link untuk direct link premium.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-puzzle-piece"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-5-title">Ekstensi Semua Browser</h4>
                    <p class="dl-meta" data-lang-key="feat-5-desc">Kompatibel penuh dengan Chrome, Edge, Firefox, Brave, Opera, dan Vivaldi tanpa ribet.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-robot"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-6-title">AI Assistant MCP Server</h4>
                    <p class="dl-meta" data-lang-key="feat-6-desc">Hubungkan ke Claude, Gemini, atau ChatGPT untuk menambah, memantau, dan mengelola unduhan via prompt AI.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-clock"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-7-title">Smart Scheduler & Antrean</h4>
                    <p class="dl-meta" data-lang-key="feat-7-desc">Manajemen antrean download berbasis waktu, batas kecepatan (speed limiter), dan auto shutdown.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-shield-alt"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-8-title">Organisir & Verifikasi Hash</h4>
                    <p class="dl-meta" data-lang-key="feat-8-desc">Kategorisasi file otomatis (Dokumen, Video, Musik, Program) dan verifikasi hash MD5/SHA-256.</p>
                </div>
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-terminal"></i></div>
                    <h4 class="dl-title" data-lang-key="feat-9-title">CLI & JSON IPC API</h4>
                    <p class="dl-meta" data-lang-key="feat-9-desc">Kendalikan RAZ DM via command line (CLI) atau integrasikan ke skrip otomatisasi headless.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================== COMPARISON MATRIX ======================== -->
    <hr class="section-separator">
    <section id="compare" class="section">
        <div class="container">
            <span class="section-label" data-lang-key="comp-label">Komparasi Terbuka</span>
            <h3 class="section-title">
                <span data-lang-key="comp-title-1">Kenapa Pindah ke</span> <span class="gold"
                    data-lang-key="comp-title-2">RAZ Download Manager?</span>
            </h3>
            <p class="section-subtitle" data-lang-key="comp-desc">
                Bandingkan langsung RAZ Download Manager dengan software legendaris berbayar dan alternatif lainnya.
            </p>

            <div class="table-responsive">
                <table class="compare-table">
                    <thead>
                        <tr>
                            <th data-lang-key="comp-th-param">Fitur / Parameter</th>
                            <th class="col-raz" data-lang-key="comp-th-raz">RAZ Download Manager</th>
                            <th data-lang-key="comp-th-idm">Internet Download Manager (IDM)</th>
                            <th data-lang-key="comp-th-others">Download Manager Lain (FDM/Motrix)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th data-lang-key="comp-price">Harga & Lisensi</th>
                            <td class="col-raz status-yes"><i class="fas fa-check-circle"></i> <span
                                    data-lang-key="comp-price-raz">100% Gratis Selamanya (GPL-3.0)</span></td>
                            <td><span data-lang-key="comp-price-idm">Berbayar ($24.95 / lisensi atau langganan)</span></td>
                            <td><span data-lang-key="comp-price-others">Gratis (Sebagian ada iklan/telemetri)</span></td>
                        </tr>
                        <tr>
                            <th data-lang-key="comp-speed">Kecepatan File 1 GiB</th>
                            <td class="col-raz status-yes"><i class="fas fa-bolt"></i> <span
                                    data-lang-key="comp-speed-raz">1.01 detik (5.4× lebih cepat)</span></td>
                            <td><span data-lang-key="comp-speed-idm">5.46 detik (median test)</span></td>
                            <td><span data-lang-key="comp-speed-others">3 - 6 detik</span></td>
                        </tr>
                        <tr>
                            <th data-lang-key="comp-engine">Teknologi Engine</th>
                            <td class="col-raz status-yes"><i class="fas fa-shield-alt"></i> <span
                                    data-lang-key="comp-engine-raz">Rust Native (Ringan, Aman, 0 Memory Leak)</span></td>
                            <td><span data-lang-key="comp-engine-idm">C++ Legacy (32-bit/64-bit klasik)</span></td>
                            <td><span data-lang-key="comp-engine-others">Electron / Java (Boros RAM)</span></td>
                        </tr>
                        <tr>
                            <th data-lang-key="comp-torrent">BitTorrent & Magnet</th>
