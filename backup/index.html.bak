                                    data-lang-key="comp-torrent-idm">Tidak Didukung</span></td>
                            <td><span data-lang-key="comp-torrent-others">Sebagian Mendukung</span></td>
                        </tr>
                        <tr>
                            <th data-lang-key="comp-video">Video Sniffer dari Web</th>
                            <td class="col-raz status-yes"><i class="fas fa-check-circle"></i> <span
                                    data-lang-key="comp-video-raz">Ya (Didukung engine yt-dlp & FFmpeg)</span></td>
                            <td class="status-yes"><i class="fas fa-check-circle"></i> <span
                                    data-lang-key="comp-video-idm">Ya (Panel download video)</span></td>
                            <td><span data-lang-key="comp-video-others">Terbatas / Butuh plugin tambahan</span></td>
                        </tr>
                        <tr>
                            <th data-lang-key="comp-debrid">Integrasi Debrid</th>
                            <td class="col-raz status-yes"><i class="fas fa-check-circle"></i> <span
                                    data-lang-key="comp-debrid-raz">Ya (Real-Debrid, AllDebrid, Debrid-Link)</span></td>
                            <td class="status-no"><i class="fas fa-times-circle"></i> <span
                                    data-lang-key="comp-debrid-idm">Tidak (Manual generate)</span></td>
                            <td><span data-lang-key="comp-debrid-others">Tidak Ada</span></td>
