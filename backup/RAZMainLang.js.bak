            'footer-help': 'Guides & Help',
            'footer-ecosystem': 'RAZ Ecosystem',
            'footer-copyright': 'RAZ Creative Studio & Open Source Contributors. All rights reserved.',
        }
    },

    getCurrentLang() {
        return localStorage.getItem(this.STORAGE_KEY) || this.DEFAULT_LANG;
    },

    setLang(lang) {
        if (!this.translations[lang]) return;
        localStorage.setItem(this.STORAGE_KEY, lang);
        this.applyTranslations(lang);

        // Update button text
        const langToggleBtn = document.getElementById('raz-lang-toggle');
        if (langToggleBtn) {
            langToggleBtn.textContent = lang === 'id' ? 'EN' : 'ID';
        }
    },

    applyTranslations(lang) {
        const dict = this.translations[lang];
        if (!dict) return;

        document.querySelectorAll('[data-lang-key]').forEach(el => {
            const key = el.getAttribute('data-lang-key');
            if (dict[key]) {
                el.innerHTML = dict[key];
            }
        });
    },

    init() {
        const currentLang = this.getCurrentLang();
        this.applyTranslations(currentLang);

        const langToggleBtn = document.getElementById('raz-lang-toggle');
        if (langToggleBtn) {
            langToggleBtn.textContent = currentLang === 'id' ? 'EN' : 'ID';
            langToggleBtn.onclick = () => {
                const newLang = this.getCurrentLang() === 'id' ? 'en' : 'id';
                this.setLang(newLang);
                if (typeof RAZModal !== 'undefined') {
                    RAZModal.toast(newLang === 'id' ? 'Bahasa diubah ke Indonesia' : 'Language switched to English', 'info', 2000);
                }
            };
        }
    }
};

if (typeof document !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
        RAZMainLang.init();
    });
}
