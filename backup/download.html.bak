<body>
    <!-- Splash Screen -->
    <div class="raz-splash-screen" id="raz-splash">
        <img src="img/raz-logo11.svg" alt="RAZ Download Manager Logo" class="raz-splash-logo" width="110" height="110">
        <div class="raz-splash-spinner"></div>
        <div class="raz-splash-text">Memuat Pusat Unduhan...</div>
    </div>

    <!-- Floating Particles -->
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>
    <div class="raz-particle"></div>

    <!-- Controls -->
    <div class="raz-controls" id="raz-controls">
        <button class="raz-control-btn raz-lang-btn" id="raz-lang-toggle" aria-label="Switch Language">EN</button>
        <button class="raz-control-btn raz-theme-btn" id="raz-theme-toggle" aria-label="Toggle Theme"><i
                class="fas fa-moon"></i></button>
    </div>

    <!-- Header -->
    <header class="header" id="main-header">
        <div class="container">
            <h1 class="logo">
                <a href="index.html" style="display:flex;align-items:center;gap:12px;">
                    <img src="img/raz-logo.svg" alt="RAZ Download Manager" class="logo-image" style="height:44px;width:auto;">
                </a>
            </h1>
            <nav class="nav-menu">
                <button class="nav-toggle" id="nav-toggle-btn" aria-label="Toggle navigation">
                    <span class="gold-line"></span>
                    <span class="gold-line"></span>
                    <span class="gold-line"></span>
                </button>
                <ul class="nav-list" id="nav-list">
                    <li><a href="index.html" class="nav-link">Beranda</a></li>
                    <li><a href="index.html#features" class="nav-link">Fitur</a></li>
                    <li><a href="benchmark.html" class="nav-link">Benchmark vs IDM</a></li>
                    <li><a href="idm-alternative.html" class="nav-link">Perbandingan</a></li>
                    <li><a href="https://github.com/razcreativestudio/razdownloadmanager" target="_blank"
                            class="nav-link"><i class="fab fa-github"></i> GitHub</a></li>
                    <li><a href="#windows" class="nav-link cta-button">Download v1.0.0</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Page Banner -->
    <section class="section" style="padding-top:140px;padding-bottom:40px;">
        <div class="container">
            <span class="section-label">Pusat Rilis Resmi</span>
            <h2 class="section-title">Unduh <span class="gold">RAZ Download Manager</span></h2>
            <p class="section-subtitle">
                Versi 1.0.0 • 100% Bebas Iklan & Spyware • Kompilasi Otomatis via GitHub Actions
            </p>
        </div>
    </section>

    <!-- Download Options Section -->
    <section class="section" style="padding-top:10px;" id="windows">
        <div class="container">
            <div class="download-grid">
                <!-- Windows Setup -->
                <div class="dl-card featured">
                    <span class="dl-badge-featured">Rekomendasi Utama</span>
                    <div class="dl-icon"><i class="fab fa-windows"></i></div>
                    <h3 class="dl-title">Windows Installer</h3>
                    <p class="dl-meta">
                        File: <code>RAZDownloadManager-1.0.0-setup.exe</code> (~65 MB)<br>
                        Mendukung Windows 10 & 11 (64-bit). Termasuk integrasi browser otomatis dan shortcut desktop.
                    </p>
                    <div class="dl-actions">
                        <a href="https://github.com/razcreativestudio/razdownloadmanager/releases/download/v1.0.0/RAZDownloadManager-1.0.0-setup.exe"
                            class="cta-primary" style="justify-content:center;">
                            <i class="fas fa-download"></i> Unduh Installer (.exe)
                        </a>
                        <button class="btn-checksum checksum-copy-btn"
                            data-hash="525cbc03e061b09e33a7df78e511896a6933a426435078b62583d589624d7fac">
                            <i class="fas fa-copy"></i> Salin SHA-256 Checksum
                        </button>
                    </div>
                </div>

                <!-- Windows Portable -->
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-file-archive"></i></div>
                    <h3 class="dl-title">Windows Portable ZIP</h3>
                    <p class="dl-meta">
                        File: <code>RAZDownloadManager-1.0.0-portable.zip</code> (~70 MB)<br>
                        Ekstrak ke folder mana pun atau simpan di flashdisk USB. Konfigurasi dan riwayat tersimpan lokal.
                    </p>
                    <div class="dl-actions">
                        <a href="https://github.com/razcreativestudio/razdownloadmanager/releases/download/v1.0.0/RAZDownloadManager-1.0.0-portable.zip"
                            class="cta-secondary" style="justify-content:center;">
                            <i class="fas fa-download"></i> Unduh Portable (.zip)
                        </a>
                        <button class="btn-checksum checksum-copy-btn"
                            data-hash="e18f762181d9ba42aac3245c6ceb6af07529d35df95a1f8922b888d95bae2d4b">
                            <i class="fas fa-copy"></i> Salin SHA-256 Checksum
                        </button>
                    </div>
                </div>

                <!-- Windows Standalone Binaries -->
                <div class="dl-card">
                    <div class="dl-icon"><i class="fas fa-terminal"></i></div>
                    <h3 class="dl-title">Windows Raw Binaries</h3>
                    <p class="dl-meta">
                        File: <code>RAZDownloadManager-1.0.0-x64.zip</code> (~68 MB)<br>
                        Berisi binary bersih <code>razdownloadmanager.exe</code>, CLI automation, dan AI MCP assistant.
                    </p>
                    <div class="dl-actions">
                        <a href="https://github.com/razcreativestudio/razdownloadmanager/releases/download/v1.0.0/RAZDownloadManager-1.0.0-x64.zip"
                            class="cta-secondary" style="justify-content:center;">
                            <i class="fas fa-download"></i> Unduh Binaries (x64.zip)
                        </a>
                        <button class="btn-checksum checksum-copy-btn"
                            data-hash="09a08986e00f2f626a8c452ccebdb8f62abf13dfc276253f10689017a896d9fb">
                            <i class="fas fa-copy"></i> Salin SHA-256 Checksum
                        </button>
                    </div>
                </div>
            </div>

            <!-- Panduan Instalasi 3 Langkah -->
            <div style="background:var(--color-dark-secondary);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:40px;margin-top:50px;text-align:left;">
                <h3 style="font-size:1.5rem;font-weight:700;margin-bottom:20px;color:var(--color-gold-accent);">
                    <i class="fas fa-clipboard-check"></i> Panduan Instalasi 3 Langkah Mudah
                </h3>
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:24px;">
                    <div style="background:var(--glass-bg);padding:20px;border-radius:var(--radius-md);border:1px solid var(--glass-border);">
                        <h4 style="color:var(--color-gold-accent);margin-bottom:8px;">1. Jalankan Installer</h4>
                        <p style="font-size:0.9rem;color:var(--color-light-secondary);">
                            Download file <code>setup.exe</code> di atas lalu klik dua kali untuk membuka. Jika muncul peringatan Windows SmartScreen, klik <b>More info → Run anyway</b>.
                        </p>
                    </div>
                    <div style="background:var(--glass-bg);padding:20px;border-radius:var(--radius-md);border:1px solid var(--glass-border);">
                        <h4 style="color:var(--color-gold-accent);margin-bottom:8px;">2. Pilih Opsi Integrasi</h4>
                        <p style="font-size:0.9rem;color:var(--color-light-secondary);">
                            Pilih bahasa antarmuka lo dan pastikan centang opsi <b>Set up browser integration</b> agar browser lo langsung otomatis terhubung.
                        </p>
                    </div>
                    <div style="background:var(--glass-bg);padding:20px;border-radius:var(--radius-md);border:1px solid var(--glass-border);">
                        <h4 style="color:var(--color-gold-accent);margin-bottom:8px;">3. Mulai Unduh!</h4>
                        <p style="font-size:0.9rem;color:var(--color-light-secondary);">
                            Buka RAZ Download Manager dari menu Start. Setiap link unduhan di browser atau link yang lo salin akan langsung ditangkap dengan kecepatan maksimal.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Checksum Reference Box -->
            <div style="margin-top:40px;text-align:left;">
                <h4 style="font-size:1.1rem;color:var(--color-light-text);margin-bottom:12px;">
                    <i class="fas fa-fingerprint gold"></i> Daftar Lengkap Checksum SHA-256
                </h4>
                <div class="checksum-box">
                    <span>RAZDownloadManager-1.0.0-setup.exe : 1ff247d9406e86bd6fab27b3c10cbffaf47e40e2c63a854d7e09e36275e75dea</span>
                    <button class="checksum-copy-btn" data-hash="1ff247d9406e86bd6fab27b3c10cbffaf47e40e2c63a854d7e09e36275e75dea">Salin</button>
                </div>
                <div class="checksum-box">
                    <span>RAZDownloadManager-1.0.0-portable.zip : 207959b1e092a80708cd4b4b6941b3ab6eb8b5445155caa11955802377e3bcf2</span>
                    <button class="checksum-copy-btn" data-hash="207959b1e092a80708cd4b4b6941b3ab6eb8b5445155caa11955802377e3bcf2">Salin</button>
                </div>
                <div class="checksum-box">
                    <span>RAZDownloadManager-1.0.0-x64.zip : 317168409490b2a259ef3f5b00d900cbc9fbade122e3d5eee74da9e92526ea06</span>
                    <button class="checksum-copy-btn" data-hash="317168409490b2a259ef3f5b00d900cbc9fbade122e3d5eee74da9e92526ea06">Salin</button>
                </div>
            </div>
        </div>
