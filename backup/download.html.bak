    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Unduh RAZ Download Manager v1.0.0 resmi untuk Windows (Installer & Portable), macOS, dan Linux. Gratis, open-source, tanpa adware, dan terverifikasi checksum SHA-256.">
    <link rel="canonical" href="https://dm.it-raz.com/download.html">
    <title>Unduh RAZ Download Manager v1.0.0 — Installer, Portable & Ekstensi Browser</title>

    <link rel="icon" href="favicon.ico" sizes="16x16 32x32 48x48 64x64">
